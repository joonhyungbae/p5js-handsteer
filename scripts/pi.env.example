# 라즈베리파이에서 켤 때 쓰는 설정. pi-setup.sh 가 이 파일을 pi.env 로 복사한다.
# 고친 뒤에는 파이를 다시 켜면 적용된다.

# 주소 뒤에 붙일 것. ?display 는 늘 붙는다. 여럿이면 & 로 잇는다.
#   cam=USB    이름에 USB 가 든 카메라로 연다 (이름은 v4l2-ctl --list-devices 로 본다)
#   in=256     사람을 찾는 그림 크기. 느리면 256, 192 로 줄인다
#   sim        카메라 없이 가짜 사람 (화면·전원 시험용)
QUERY=""

# 화면 회전. 세로로 달면 90 이나 270. 비워 두면 돌리지 않는다.
ROTATE=""

# 회전할 화면 이름. 비워 두면 처음 찾은 화면. 이름은 wlr-randr 로 본다 (예: HDMI-A-1, DSI-1)
OUTPUT=""

# 1 이면 켤 때마다 온도와 전원 상태를 ~/handsteer-check.csv 에 10초마다 적는다 (배터리·열 시험용)
CHECK=""
